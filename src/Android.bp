cc_binary_host {

    name: "makeguids",
    local_include_dirs: ["include"],
    cflags: ["-DEFIVAR_BUILD_ENVIRONMENT"],
    srcs: [
        "guid.c",
        "makeguids.c",
    ],
    host_ldlibs: ["-ldl"],
}
